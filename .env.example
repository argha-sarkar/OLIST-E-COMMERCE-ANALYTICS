# Copy to .env and fill in. .env is gitignored — never commit real credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=olist

# mysql | csv   (csv = run analysis without a database, e.g. in CI)
DATA_SOURCE=mysql

# Analysis window. 2016 has <1% of orders and is excluded by default.
ANALYSIS_START_DATE=2017-01-01

# Assumption used only for the CLV proxy. State it in the report.
GROSS_MARGIN_ASSUMPTION=0.30
